{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsforge.lab/contract/toolchain.schema.json",
  "title": "OpsForge lab toolchain documents (contract 1)",
  "description": "The documents of `opsforge api`: inputs (stdin, or HTTP request bodies) and outputs (stdout, or HTTP responses; contract/openapi.yaml) of run|probe|heal|validate-steps|version, and the HTTP API's jobs, problems and workspace listings (contract/README.md). Steps are scenario steps (lab/scenario.py); their placeholders are resolved by the toolchain, `${ns}` with the document's namespace. Inputs are strict. Outputs may gain fields in a minor version: readers ignore the ones they do not know (OpsForge's golden documents pin exactly what it prints).",
  "$defs": {
    "namespace": {
      "description": "A namespace the platform owns: lab-<attempt> for labs, ch-<attempt> for challenge submissions. Created before setup, deleted after teardown.",
      "type": "string",
      "pattern": "^(lab|ch)-[a-z0-9]{1,24}$"
    },
    "steps": { "type": "array", "items": { "type": "object", "minProperties": 1 } },
    "log": { "description": "Human-readable lines, each starting with the seconds since the run began.", "type": "array", "items": { "type": "string" } },
    "error": { "description": "Why the run stopped early (a failing step, a missing node); null when every step ran.", "type": ["string", "null"] },
    "metrics": { "type": "object", "additionalProperties": { "type": "number" } },
    "condition": { "description": "<op> <value>, e.g. \">= base.p50_ms * 2\" (lab/scenario.py)", "type": "string", "pattern": "^\\s*(<=|>=|==|!=|<|>)" },
    "runInput": {
      "type": "object",
      "required": ["contract", "phase", "steps"],
      "additionalProperties": false,
      "properties": {
        "contract": { "const": 1 },
        "phase": { "enum": ["setup", "teardown"] },
        "steps": { "$ref": "#/$defs/steps" },
        "namespace": { "$ref": "#/$defs/namespace" }
      }
    },
    "runOutput": {
      "type": "object",
      "required": ["contract", "metrics", "log", "error"],
      "properties": {
        "contract": { "const": 1 },
        "metrics": { "$ref": "#/$defs/metrics" },
        "log": { "$ref": "#/$defs/log" },
        "error": { "$ref": "#/$defs/error" }
      }
    },
    "probeInput": {
      "type": "object",
      "required": ["contract", "steps", "expect"],
      "additionalProperties": false,
      "properties": {
        "contract": { "const": 1 },
        "steps": { "$ref": "#/$defs/steps" },
        "expect": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "oneOf": [{ "$ref": "#/$defs/condition" }, { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } }]
          }
        },
        "namespace": { "$ref": "#/$defs/namespace" }
      }
    },
    "probeOutput": {
      "type": "object",
      "required": ["contract", "passed", "results", "log", "error"],
      "properties": {
        "contract": { "const": 1 },
        "passed": { "type": "boolean" },
        "results": {
          "description": "One per expectation, in `expect` order. checked is false for a step the probe never reached (it stops at the first failing named step).",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["metric", "want", "got", "passed", "checked"],
            "properties": {
              "metric": { "type": "string" },
              "want": { "type": "string" },
              "got": { "type": ["number", "null"] },
              "passed": { "type": "boolean" },
              "checked": { "type": "boolean" }
            }
          }
        },
        "log": { "$ref": "#/$defs/log" },
        "error": { "$ref": "#/$defs/error" }
      }
    },
    "healOutput": {
      "type": "object",
      "required": ["contract", "healed"],
      "properties": {
        "contract": { "const": 1 },
        "healed": { "description": "false when there was no fault to heal", "type": "boolean" }
      }
    },
    "stepsInput": {
      "type": "object",
      "required": ["contract", "sets"],
      "additionalProperties": false,
      "properties": {
        "contract": { "const": 1 },
        "sets": {
          "description": "Sets of scenario steps to check without running them: a lab's setup or teardown, a check's probe (with its expect).",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["steps"],
            "additionalProperties": false,
            "properties": {
              "steps": { "type": "array" },
              "expect": { "type": "object" },
              "faults": { "description": "false: fault steps (partition, degrade, ...) are refused, as in a check that only observes the lab", "type": "boolean" }
            }
          }
        }
      }
    },
    "stepsOutput": {
      "type": "object",
      "required": ["contract", "errors"],
      "properties": {
        "contract": { "const": 1 },
        "errors": {
          "description": "Why steps would not run, in set order; empty when every set is valid.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["set", "message"],
            "properties": {
              "set": { "description": "Index of the set in the input", "type": "integer", "minimum": 0 },
              "message": { "description": "steps[<i>]: ... or expect: <metric>: ...", "type": "string" }
            }
          }
        }
      }
    },
    "problem": {
      "description": "Why a call failed (RFC 9457 fields): on stderr from the CLI, as the body of an HTTP error (application/problem+json), or a failed job's `problem`.",
      "type": "object",
      "required": ["contract", "type", "title", "detail"],
      "properties": {
        "contract": { "const": 1 },
        "type": { "type": "string", "pattern": "^/problems/[a-z-]+$" },
        "title": { "type": "string" },
        "detail": { "type": "string" }
      }
    },
    "jobOutput": {
      "description": "A run, probe or heal started over HTTP (POST /v1/runs|probes|heal): `log` grows while it runs; once done, `output` is the command's output document; failed: `problem` says why (not a failing step: that is the output's `error`).",
      "type": "object",
      "required": ["contract", "id", "kind", "status", "log", "output", "problem"],
      "properties": {
        "contract": { "const": 1 },
        "id": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
        "kind": { "enum": ["run", "probe", "heal"] },
        "status": { "enum": ["running", "done", "failed"] },
        "log": { "$ref": "#/$defs/log" },
        "output": { "description": "runOutput, probeOutput or healOutput (by kind) once done, else null", "type": ["object", "null"] },
        "problem": { "oneOf": [{ "$ref": "#/$defs/problem" }, { "type": "null" }] }
      }
    },
    "filesOutput": {
      "description": "A workspace's regular files (GET /v1/workspaces/{ws}/files), by path, and their total size.",
      "type": "object",
      "required": ["contract", "files", "bytes"],
      "properties": {
        "contract": { "const": 1 },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "size"],
            "properties": { "path": { "type": "string" }, "size": { "type": "integer", "minimum": 0 } }
          }
        },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "moveInput": {
      "type": "object",
      "required": ["contract", "from", "to"],
      "additionalProperties": false,
      "properties": {
        "contract": { "const": 1 },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 }
      }
    },
    "versionOutput": {
      "type": "object",
      "required": ["contract", "minor", "opsforge"],
      "properties": {
        "contract": { "const": 1 },
        "minor": { "description": "Additive revisions of this major: a caller gates what it sends on it", "type": "integer", "minimum": 0 },
        "opsforge": { "description": "The OpsForge release (semver)", "type": "string" }
      }
    }
  }
}
