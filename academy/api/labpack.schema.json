{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsforge.lab/labpack.schema.json",
  "title": "OpsForge teaching-lab pack",
  "description": "A loaded pack: pack.yml plus its curricula, labs and badges (docs/PLAN.md Phase 10). Cross-references are checked by internal/compiler, scenario steps by OpsForge (`opsforge api validate-steps`).",
  "type": "object",
  "required": ["pack", "curricula", "labs", "badges"],
  "additionalProperties": false,
  "properties": {
    "pack": {
      "type": "object",
      "required": ["id", "title", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "version": { "type": ["string", "integer"] },
        "author": { "type": "string" },
        "description": { "type": "string" },
        "hint_penalty": { "type": "number", "minimum": 0, "maximum": 0.5 }
      }
    },
    "curricula": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/curriculum" }
    },
    "labs": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/lab" }
    },
    "badges": {
      "type": "array",
      "items": { "$ref": "#/$defs/badge" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$" },
    "text": { "type": "string", "minLength": 1 },
    "path": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$", "not": { "pattern": "(^|/)\\.\\.?(/|$)" } },
    "steps": { "type": "array", "items": { "type": "object", "minProperties": 1 } },
    "curriculum": {
      "type": "object",
      "required": ["title", "levels"],
      "additionalProperties": false,
      "properties": {
        "title": { "$ref": "#/$defs/text" },
        "summary": { "type": "string" },
        "position": { "type": "integer" },
        "levels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["title", "labs"],
            "additionalProperties": false,
            "properties": {
              "title": { "$ref": "#/$defs/text" },
              "summary": { "type": "string" },
              "xp_required": { "type": "integer", "minimum": 0 },
              "labs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }
            }
          }
        }
      }
    },
    "lab": {
      "type": "object",
      "required": ["title", "summary", "briefing", "steps"],
      "additionalProperties": false,
      "properties": {
        "title": { "$ref": "#/$defs/text" },
        "summary": { "$ref": "#/$defs/text" },
        "briefing": { "$ref": "#/$defs/text" },
        "xp": { "type": "integer", "minimum": 0 },
        "minutes": { "type": "integer", "minimum": 1 },
        "layout": { "enum": ["stretched", "multi-cluster"] },
        "needs": { "type": "array", "uniqueItems": true, "items": { "enum": ["vpn", "k3s", "monitoring", "ci"] } },
        "requires": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "concepts": { "type": "array", "items": { "type": "string" } },
        "setup": { "$ref": "#/$defs/steps" },
        "teardown": { "$ref": "#/$defs/steps" },
        "debrief": { "type": "string" },
        "namespace": { "const": "auto", "description": "Phase 11: setup creates lab-<attempt>, teardown deletes it; ${ns} in texts" },
        "files": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" }, "description": "Phase 11: copied from labs/<lab>/files/ into the workspace" },
        "cluster_changes": { "type": "array", "items": { "$ref": "#/$defs/text" }, "description": "Phase 11: changes outside the namespace, shown before starting" },
        "reset": { "enum": ["setup", "snapshot"] },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "title", "body", "check"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "title": { "$ref": "#/$defs/text" },
              "body": { "$ref": "#/$defs/text" },
              "hints": { "type": "array", "items": { "$ref": "#/$defs/text" } },
              "open": { "$ref": "#/$defs/path" },
              "check": { "type": "object", "minProperties": 1, "maxProperties": 1 }
            }
          }
        }
      }
    },
    "badge": {
      "type": "object",
      "required": ["id", "title", "description", "rule"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" },
        "icon": { "enum": ["lamp", "signal", "points", "token", "route", "bell"] },
        "rule": { "type": "object", "required": ["type"] }
      }
    }
  }
}
